# Server Configuration
PORT=3000

# Optional: Enables "Ask Amir" AI Assistant (POST /api/ai/assist)
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback alias for GEMINI_API_KEY (used only if GEMINI_API_KEY is unset)
AI_PROVIDER_API_KEY=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Consent-gated in the browser; app runs without it when unset
VITE_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=

# Unused legacy export variables (not required for local development or production)
AUDIO_SAMPLES_CDN_BASE=
AUTH_SESSION_SECRET=
BASE44_API_BASE_URL=
BASE44_APP_ID=
STRIPE_SECRET_KEY=